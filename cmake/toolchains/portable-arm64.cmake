set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{PMJS_SDK_ROOT})
  message(FATAL_ERROR "PMJS_SDK_ROOT must name the prepared portable SDK")
endif()
set(PMJS_SDK_ROOT "$ENV{PMJS_SDK_ROOT}")
set(CMAKE_C_COMPILER "${PMJS_SDK_ROOT}/bin/cc")
set(CMAKE_CXX_COMPILER "${PMJS_SDK_ROOT}/bin/c++")
set(CMAKE_AR "${PMJS_SDK_ROOT}/bin/ar")
set(CMAKE_RANLIB "${PMJS_SDK_ROOT}/bin/ranlib")
set(CMAKE_FIND_ROOT_PATH "${PMJS_SDK_ROOT}/prefix" "${PMJS_SDK_ROOT}/sysroot/usr")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
