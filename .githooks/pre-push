#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
unset $(git rev-parse --local-env-vars)

echo "Running the PMJS CI checks before push..."
npm ci
npm run lint
npm run licensing
npm test

if [ ! -f build/dev/build.ninja ]; then
  cmake --preset dev
fi
cmake --build --preset dev --target pmjs-native-smoke --parallel 4
ctest --preset dev -L '^(smoke|build)$' --parallel 4 --no-tests=error --timeout 180
